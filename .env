# Defaults do ambiente local. Segredos ficam sem default (ex.: ${WWZ_ADMIN_TOKEN:?}).
VALKEY_VERSION=8.1
VALKEY_PORT=16379
VALKEY_MAXMEMORY=256mb
VALKEY_CPUS=1
VALKEY_MEMORY=384m
WWZ_PORT=18000
WWZ_ADMIN_PORT=18001
WWZ_CPUS=1
WWZ_MEMORY=512m
WWZ_NOFILE=1048576
WWZ_STORE=valkey
# WWZ_STORE=memory exige também WWZ_VALKEY_ADDR= (vazio): o endereço força store valkey.
PROMETHEUS_VERSION=v3.7.0
PROMETHEUS_PORT=19090
PROMETHEUS_CPUS=1
PROMETHEUS_MEMORY=512m
WWZ_PANEL_PORT=18002
WWZ_PANEL_CPUS=1
WWZ_PANEL_MEMORY=256m
WWZ_LOAD_CPUS=1
WWZ_LOAD_MEMORY=256m
# WWZ_ADMIN_TOKEN=            # obrigatório fora de 127.0.0.1, sem default
# WWZ_PANEL_ADMIN_PASSWORD=   # sem default (vazio = gerada e impressa uma vez no log, ADR 0005)
# WWZ_PANEL_API_TOKEN=        # sem default (vazio desliga o bearer de automação)
