# Copie para /opt/white-wizard/heavy/.env no servidor (nunca vai para o git e o
# verify-heavy nunca sobrescreve). Só ajustes de recurso; nenhum segredo é
# necessário para as rodadas. Teto (ADR 0017): a soma de cpus ≤ 32 e de memória
# ≤ 64g, contando a rodada e os containers wwz* da produção que ficaram de pé
# (o run.sh recusa a rodada acima disso). Com as instâncias de papel paradas a
# produção mantém 12 cpus/22g; na rodada streams o verify também para o
# wwz-admin (6 cpus/12g), e sobram 6 cpus/10g.

# Valkey Cluster (rodada cluster): 3 mestres + limits.test.
HEAVY_VALKEY_CPUS=2
HEAVY_VALKEY_MEMORY=2g
HEAVY_VALKEY_MAXMEMORY=1gb
HEAVY_TEST_CPUS=4
HEAVY_TEST_MEMORY=2g

# wwz na rodada throughput: 8 vCPUs, a meta da spec 014.
HEAVY_WWZ_CPUS=8
HEAVY_WWZ_MEMORY=16g
HEAVY_WWZ_LOG_LEVEL=warn
# wwz na rodada streams: 12 núcleos (ADR da task 269: ITL p99 ≤ 22 ms com
# 20 000 streams vale com folga de CPU; com 8 o wwz satura e o p99 vai a ~29 ms).
HEAVY_STREAMS_WWZ_CPUS=12
HEAVY_STREAMS_WWZ_MEMORY=16g

# wwz-load: 8 CPUs no throughput (spec 018, 5b). Nos streams o cliente abre
# HEAVY_STREAMS conexões e lê ~50 eventos/s de cada uma; ganha mais CPU para o
# ITL medido ser o do wwz, não o da fila do cliente (6 + 12 + 14 = 32).
HEAVY_LOAD_CPUS=8
HEAVY_LOAD_MEMORY=16g
HEAVY_STREAMS_LOAD_CPUS=14
HEAVY_STREAMS_LOAD_MEMORY=24g

# Proteções do servidor (ADR 0017).
HEAVY_MAX_LOAD=48
HEAVY_ROUND_TIMEOUT=600
HEAVY_MAX_CPUS=32
HEAVY_MAX_MEMORY_GB=64

# Imagem do Valkey (puxada na rodada cluster e removida no cleanup se não
# existia antes).
HEAVY_VALKEY_IMAGE=valkey/valkey:8.1-alpine
