# Exemplo com valores FICTÍCIOS. O .env real é gerado NO servidor por
# `scripts/prod-deploy.sh credentials` (/opt/white-wizard/.env, chmod 600) e
# nunca entra no repositório. Aqui só o que o teste de deploy/prod usa.
WWZ_ADMIN_TOKEN=exemplo-admin-token-ficticio
WWZ_KEY_1=wwz-key-exemplo-ficticio-1
WWZ_KEY_2=wwz-key-exemplo-ficticio-2
WWZ_KEY_3=wwz-key-exemplo-ficticio-3
WWZ_OAUTH_KEY=wwz-key-exemplo-ficticio-oauth
WWZ_PANEL_ADMIN_USER=admin
WWZ_PANEL_ADMIN_PASSWORD=exemplo-senha-painel-ficticia
WWZ_PANEL_API_TOKEN=exemplo-api-token-ficticio
WWZ_PANEL_SESSION_KEY=exemplo-session-key-ficticia
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=exemplo-senha-grafana-ficticia

# Hosts HTTPS (sem padrão no compose): no servidor, o prod-deploy.sh grava os de
# autor/prod.env (ADR 0076). Aqui os de exemplo de deploy/prod/autor.env.example.
WWZ_HOST_INFERENCIA=wwz.example.com
WWZ_HOST_ADMIN=admin-wwz.example.com
WWZ_HOST_PANEL=panel-wwz.example.com
WWZ_HOST_GRAFANA=grafana-wwz.example.com

# images.env (escrito por `prod-deploy.sh push-images`)
WWZ_IMAGE=white-wizard:prod-exemplo
WWZ_PANEL_IMAGE=white-wizard-panel:prod-exemplo
WWZ_LOAD_IMAGE=white-wizard-load:prod-exemplo

# Opcionais (padrões no docker-compose.yml)
# WWZ_LOG_LEVEL=warn
# WWZ_CONFIG_DIR=./run/config
