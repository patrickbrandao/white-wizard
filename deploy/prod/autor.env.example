# Modelo de autor/prod.env (ADR 0076) com valores de EXEMPLO. O arquivo real fica
# em autor/prod.env na raiz do repositório, fora do git (/autor/ no .gitignore):
#   mkdir -p autor && cp deploy/prod/autor.env.example autor/prod.env
# Sintaxe de shell: scripts/prod-deploy.sh, scripts/prod-smoke.sh, scripts/heavy.sh
# e deploy/prod/test.sh fazem `source` dele (WWZ_AUTHOR_ENV troca o caminho);
# variáveis já definidas no ambiente têm precedência sobre o arquivo.

# Acesso ssh ao host (prod-deploy.sh, prod-smoke.sh --ssh)
WWZ_PROD_SSH=root@prod.example.com
WWZ_PROD_SSH_PORT=22

# IP público das portas 8000-8008 e IP privado do host (informativo)
WWZ_PROD_PUBLIC_IP=203.0.113.10
WWZ_PROD_PRIVATE_IP=10.0.0.10

# Hosts HTTPS (Traefik): o prod-deploy.sh grava estes quatro no .env do servidor,
# de onde o deploy/prod/docker-compose.yml os lê
WWZ_HOST_INFERENCIA=wwz.example.com
WWZ_HOST_ADMIN=admin-wwz.example.com
WWZ_HOST_PANEL=panel-wwz.example.com
WWZ_HOST_GRAFANA=grafana-wwz.example.com

# verify-heavy (scripts/heavy.sh): comando ssh até o servidor pesado
WWZ_HEAVY_SSH="ssh -p 22 root@prod.example.com"

# Opcional: haproxy.cfg próprio do servidor (relativo à raiz do repositório). Sem
# esta linha o `prod-deploy.sh sync` envia o genérico deploy/prod/haproxy/haproxy.cfg.
# WWZ_PROD_HAPROXY=autor/haproxy.cfg
